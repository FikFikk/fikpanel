[Unit]
Description=fikpanel Web Server (Unprivileged)
After=network.target nginx.service
Wants=panel-agent.socket

[Service]
User=panel
Group=panel
EnvironmentFile=/etc/panel/panel.env
Environment=GOMEMLIMIT=48MiB
Environment=GOGC=50
ExecStart=/usr/local/bin/fikpanel serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/panel
PrivateTmp=yes
MemoryMax=64M
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

